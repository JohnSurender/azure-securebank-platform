{
  "properties": {
    "displayName": "SecureBank - UK data residency (uksouth, ukwest only)",
    "policyType": "Custom",
    "mode": "All",
    "policyRule": {
      "if": {
        "not": { "field": "location", "in": ["uksouth", "ukwest", "global"] }
      },
      "then": { "effect": "deny" }
    }
  }
}
